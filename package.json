{
  "name": "billing-app-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "Billing Application using Microservices Architecture",
  "workspaces": [
    "api-gateway",
    "user-service",
    "utils"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w api-gateway\" \"npm run dev -w user-service\"",
    "build": "npm run build -w utils && npm run build -w api-gateway && npm run build -w user-service",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules package-lock.json api-gateway/node_modules user-service/node_modules utils/node_modules",
    "rebuild": "npm run clean && npm install"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}