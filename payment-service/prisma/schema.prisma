generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String        // references Booking Service's Booking by ID, no cross-service FK
  userId         String        // references User Service, no cross-service FK
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         PaymentStatus
  idempotencyKey String        @unique
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([bookingId])
  @@index([userId])
}
