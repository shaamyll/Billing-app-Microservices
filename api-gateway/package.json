    "http-proxy-middleware": "^3.0.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.7",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}