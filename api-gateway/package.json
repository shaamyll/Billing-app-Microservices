{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for Bill Box microservices",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "keywords": [
    "billing",
    "api-gateway",
    "microservice"
  ],
  "license": "ISC",
  "dependencies": {
