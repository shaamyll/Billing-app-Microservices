{
  "info": {
    "_postman_id": "routego-trip-service-collection",
    "name": "RouteGo - Trip Service",
    "description": "Postman collection for testing Bus management and Trip scheduling in RouteGo (via API Gateway and direct service).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "busId",
      "value": "",
      "type": "string"
    },
    {
      "key": "routeId",
      "value": "3e3fa180-494b-4646-9421-f1529e7d386d",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Buses",
      "item": [
        {
          "name": "1. Register Bus with Full Seat Layout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Bus created with seats\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.seats).to.be.an('array').with.lengthOf(6);",
                  "    pm.collectionVariables.set(\"busId\", json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"KA-01-EQ-5599\",\n  \"operatorName\": \"RouteGo Express\",\n  \"busType\": \"AC_SLEEPER\",\n  \"totalSeats\": 6,\n  \"seats\": [\n    { \"seatNumber\": \"L1\", \"seatType\": \"LOWER_BERTH\" },\n    { \"seatNumber\": \"L2\", \"seatType\": \"LOWER_BERTH\" },\n    { \"seatNumber\": \"L3\", \"seatType\": \"LOWER_BERTH\" },\n    { \"seatNumber\": \"U1\", \"seatType\": \"UPPER_BERTH\" },\n    { \"seatNumber\": \"U2\", \"seatType\": \"UPPER_BERTH\" },\n    { \"seatNumber\": \"U3\", \"seatType\": \"UPPER_BERTH\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/buses",
              "host": ["{{baseUrl}}"],
              "path": ["buses"]
            },
            "description": "Registers a bus and creates its full seat layout in a single atomic transaction."
          },
          "response": []
        },
        {
          "name": "2. Get Bus Seat Layout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Bus layout returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.seats).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/buses/{{busId}}/layout",
              "host": ["{{baseUrl}}"],
              "path": ["buses", "{{busId}}", "layout"]
            },
            "description": "Fetches a bus's seat layout."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "3. Schedule a Trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Trip scheduled successfully\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.collectionVariables.set(\"tripId\", json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routeId\": \"{{routeId}}\",\n  \"busId\": \"{{busId}}\",\n  \"departureDate\": \"2026-09-25\",\n  \"departureTime\": \"10:30 PM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trips",
              "host": ["{{baseUrl}}"],
              "path": ["trips"]
            },
            "description": "Schedules a trip for a route using a registered bus."
          },
          "response": []
        },
        {
          "name": "4. Search Trips by Route and Date",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Trips list returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/trips?routeId={{routeId}}&date=2026-09-25",
              "host": ["{{baseUrl}}"],
              "path": ["trips"],
              "query": [
                {
                  "key": "routeId",
                  "value": "{{routeId}}"
                },
                {
                  "key": "date",
                  "value": "2026-09-25"
                }
              ]
            },
            "description": "Searches for scheduled trips on a specific route and date."
          },
          "response": []
        },
        {
          "name": "5. Get Trip with Full Seat Layout (for Booking UI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Trip details with seat layout returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.bus).to.have.property('seats');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}"]
            },
            "description": "Returns trip details joined with the bus's full seat layout to render seat maps."
          },
          "response": []
        },
        {
          "name": "6. Get Trip Seats Only",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Seat array returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/seats",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "seats"]
            },
            "description": "Returns just the seat layout for a trip."
          },
          "response": []
        }
      ]
    }
  ]
}
